{
  "name": "ltx-studio",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c yellow,cyan \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "bundle:report": "node scripts/bundle-report.mjs",
    "release:surface": "tsx scripts/generate-release-surface.ts --output release/candidate-release-surface.v1.json",
    "release:hermetic-build": "node scripts/hermetic-release-build.mjs",
    "release:emit": "tsc --project tsconfig.release.json",
    "release:stage": "node scripts/hermetic-release-build.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:verify": "node scripts/verify-release-manifest.mjs",
    "release:verify:static": "node scripts/verify-release-manifest.mjs --static-only",
    "audit:preflight": "node scripts/preflight-release-audit.mjs",
    "audit:security": "node scripts/audit-release-security.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:finalize": "node scripts/finalize-release-audit.mjs",
    "audit:promotion": "node scripts/prepare-release-promotion.mjs",
    "release:install": "node scripts/install-release.mjs",
    "release:attest-host-tcb": "node scripts/attest-installed-release.mjs",
    "startup:measure": "node scripts/measure-startup.mjs",
    "startup:measure-paired": "node scripts/measure-startup-paired.mjs",
    "startup:compare": "node scripts/compare-startup.mjs",
    "m0:evidence": "tsx scripts/generate-m0-evidence.ts",
    "evidence:lipsync-delay": "node scripts/verify-lipsync-delay-evidence.mjs",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
