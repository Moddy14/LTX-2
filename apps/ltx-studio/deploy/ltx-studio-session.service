[Unit]
Description=LTX Studio :4318 with sealed phoneme-viseme evaluator
After=dgx-runtime-api.service
Wants=dgx-runtime-api.service

[Service]
Type=simple
User=moddy
Group=moddy
WorkingDirectory=/home/moddy/LTX-2/apps/ltx-studio
EnvironmentFile=/opt/ltx-studio-phoneme-viseme/ltx-studio.env
ExecStart=/home/moddy/.nvm/versions/node/v24.18.0/bin/npm start
Restart=on-failure
RestartSec=3
# A render subprocess may be picked by the kernel OOM killer for a foreign
# allocation (2026-08-06: killed at 39 GiB, 19 GiB below its own admission).
# Keep the server alive so it can mark the job interrupted instead of losing
# the whole session to systemd's default OOMPolicy=stop.
OOMPolicy=continue
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
IPAddressAllow=::1/128

[Install]
WantedBy=multi-user.target
